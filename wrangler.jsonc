{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-hangul",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SKY", "class_name": "SharedSky" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SharedSky"] }]
}
